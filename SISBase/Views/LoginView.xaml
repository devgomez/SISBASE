<Window x:Class="SISBase.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SIS ERP - Acceso"
        Height="650"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                CornerRadius="0,24,24,0"
                ClipToBounds="True">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F3D5E" Offset="0"/>
                    <GradientStop Color="#0A2A43" Offset="0.65"/>
                    <GradientStop Color="#132236" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>

                <Canvas>

                    <Ellipse Width="540"
                             Height="540"
                             Fill="#14FFFFFF"
                             Canvas.Left="-220"
                             Canvas.Top="260"/>

                    <Ellipse Width="310"
                             Height="310"
                             Fill="#0BFFFFFF"
                             Canvas.Left="560"
                             Canvas.Top="-90"/>

                    <Rectangle Width="260"
                               Height="260"
                               RadiusX="42"
                               RadiusY="42"
                               Fill="#09FFFFFF"
                               RenderTransformOrigin="0.5,0.5"
                               Canvas.Left="360"
                               Canvas.Top="360">

                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="18"/>
                        </Rectangle.RenderTransform>

                    </Rectangle>

                </Canvas>

                <StackPanel HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="90,0,90,0">

                    <materialDesign:PackIcon
                        Kind="Warehouse"
                        Width="92"
                        Height="92"
                        Foreground="#E7F1FA"/>

                    <TextBlock Text="SIS ERP"
                               FontSize="54"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,22,0,8"/>

                    <TextBlock Text="Opera tu negocio con orden, velocidad y control."
                               FontSize="22"
                               Foreground="#E6EEF7"
                               TextWrapping="Wrap"
                               Margin="0,0,0,26"/>

                    <StackPanel>
                        <TextBlock Text="• Control centralizado de clientes y operaciones"
                                   Foreground="#D9E7F5"
                                   FontSize="16"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="• Flujos de trabajo claros para tu equipo"
                                   Foreground="#D9E7F5"
                                   FontSize="16"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="• Información lista para tomar decisiones"
                                   Foreground="#D9E7F5"
                                   FontSize="16"/>
                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>

        <Grid Grid.Column="1"
              Background="{StaticResource SurfaceBrush}">

            <StackPanel Width="460"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock Text="Bienvenido" 
                           FontSize="40"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left"/>

                <TextBlock Text="Accede con tu cuenta para continuar"
                           FontSize="16"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,30"/>

                <Border Style="{StaticResource AppCardStyle}"
                        Padding="24">

                    <StackPanel>

                        <TextBlock Text="Usuario"
                                   FontSize="14"
                                   Margin="0,0,0,6"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBox x:Name="txtUser"
                                 FontSize="18"
                                 materialDesign:HintAssist.Hint="Ingresa tu usuario"/>

                        <TextBlock Text="Contraseña"
                                   FontSize="14"
                                   Margin="0,10,0,6"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <PasswordBox x:Name="txtPassword"
                                     FontSize="18"
                                     materialDesign:HintAssist.Hint="Ingresa tu contraseña"/>

                        <DockPanel Margin="0,6,0,10">
                            <CheckBox Content="Recordarme"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="¿Olvidaste tu contraseña?"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       DockPanel.Dock="Right"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <Button Height="52"
                                Name="btnLogIn"
                                Style="{StaticResource AppPrimaryButtonStyle}"
                                Click="btnLogIn_Click">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                <materialDesign:PackIcon
                                    Kind="LoginVariant"
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,10,0"
                                    Foreground="White"/>

                                <TextBlock Text="Ingresar"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="White"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </Border>

                <TextBlock Text="Versión 1.0.0"
                           FontSize="13"
                           Margin="0,16,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Left"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>