<Window x:Class="SISBase.Views.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SIS ERP"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">

    <Window.Resources>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">

            <Setter Property="Foreground" Value="#E4EDF8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,0,10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#274C68"/>
                    <Setter Property="BorderBrush" Value="#3C6A8B"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#345D7A"/>
                </Trigger>
            </Style.Triggers>

        </Style>

        <Style x:Key="SidebarLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E4EDF8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SidebarIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="#CFE2F6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TopIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignToolButton}">

            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarHost"
                Grid.Column="0"
                Margin="12"
                Width="254"
                CornerRadius="18"
                Padding="10,12"
                BorderThickness="1"
                BorderBrush="#234560">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#102F47" Offset="0"/>
                    <GradientStop Color="#0B2538" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">

                    <Border Width="42"
                            Height="42"
                            CornerRadius="12"
                            Background="#214560">

                        <materialDesign:PackIcon
                            Kind="Warehouse"
                            Width="24"
                            Height="24"
                            Foreground="White"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"/>

                    </Border>

                    <StackPanel Margin="12,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="txtLogo"
                                   Text="SIS ERP"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="txtLogoSubtitle"
                                   Text="Panel administrativo"
                                   Foreground="#AAC4DA"
                                   FontSize="12"/>

                    </StackPanel>

                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="4,8,4,0">

                    <StackPanel x:Name="MenuContainer" Margin="0,6,0,0">

                        <Button x:Name="btnDashboard"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="Dashboard_Click">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="ViewDashboardOutline" Style="{StaticResource SidebarIconStyle}"/>
                                <TextBlock Grid.Column="2" x:Name="txtDashboard" Text="Dashboard" Style="{StaticResource SidebarLabelStyle}"/>
                            </Grid>

                        </Button>

                        <Button x:Name="btnProducts"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="Products_Click">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="PackageVariantClosed" Style="{StaticResource SidebarIconStyle}"/>
                                <TextBlock Grid.Column="2" x:Name="txtProducts" Text="Productos" Style="{StaticResource SidebarLabelStyle}"/>
                            </Grid>

                        </Button>

                        <Button x:Name="btnCustomers"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="Customers_Click">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="AccountGroupOutline" Style="{StaticResource SidebarIconStyle}"/>
                                <TextBlock Grid.Column="2" x:Name="txtCustomers" Text="Clientes" Style="{StaticResource SidebarLabelStyle}"/>
                            </Grid>

                        </Button>

                        <Button x:Name="btnRoles"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="btnRoles_Click">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="ShieldAccountOutline" Style="{StaticResource SidebarIconStyle}"/>
                                <TextBlock Grid.Column="2" x:Name="txtSales" Text="Roles" Style="{StaticResource SidebarLabelStyle}"/>
                            </Grid>

                        </Button>

                        <Button x:Name="btnUsuarios"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="btnUsuarios_Click">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="AccountSupervisorCircleOutline" Style="{StaticResource SidebarIconStyle}"/>
                                <TextBlock Grid.Column="2" x:Name="txtPurchases" Text="Usuarios y Roles" Style="{StaticResource SidebarLabelStyle}"/>
                            </Grid>

                        </Button>

                        <Button x:Name="btnOpciones"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="btnOptions_Click">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="TuneVariant" Style="{StaticResource SidebarIconStyle}"/>
                                <TextBlock Grid.Column="2" x:Name="txtInvoices" Text="Opciones" Style="{StaticResource SidebarLabelStyle}"/>
                            </Grid>

                        </Button>

                    </StackPanel>

                </ScrollViewer>

                <Border Grid.Row="2"
                        BorderBrush="#29445A"
                        BorderThickness="0,1,0,0">

                    <TextBlock x:Name="txtVersion"
                               Text="ERP v1.0"
                               Foreground="#98B1C6"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

            </Grid>

        </Border>

        <Grid Grid.Column="1" Margin="0,12,12,12">

            <Grid.RowDefinitions>
                <RowDefinition Height="88"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource AppCardStyle}"
                    Padding="18,12">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnMenu"
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            Click="BtnMenu_Click"
                            Style="{StaticResource MaterialDesignToolButton}">

                        <materialDesign:PackIcon Kind="Menu"/>

                    </Button>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtPageTitle"
                                   Text="Dashboard"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Gestiona tu operación diaria desde un solo lugar"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Style="{StaticResource TopIconButtonStyle}">
                            <materialDesign:PackIcon x:Name="btnAlert" Kind="BellOutline"/>
                        </Button>

                        <Button Style="{StaticResource TopIconButtonStyle}">
                            <materialDesign:PackIcon x:Name="btnSettings" Kind="CogOutline"/>
                        </Button>

                        <Border Width="38"
                                Height="38"
                                CornerRadius="19"
                                Background="#EAF1F8"
                                Margin="4,0,0,0">

                            <materialDesign:PackIcon
                                Kind="Account"
                                Width="22"
                                Height="22"
                                Foreground="{StaticResource PrimaryBrush}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>

                        </Border>

                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Administrador" FontWeight="SemiBold"/>
                            <TextBlock Text="admin@siserp.com"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                    </StackPanel>

                </Grid>

            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource AppCardStyle}"
                    Margin="0,12,0,0"
                    Padding="12">

                <ContentControl x:Name="MainContent"/>

            </Border>

        </Grid>

    </Grid>

</Window>