<UserControl x:Class="SISBase.Views.Controls.UCButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="root">

    <Button
        Command="{Binding Command, ElementName=root}"
        Width="{Binding ButtonWidth, ElementName=root}"
        Height="{Binding ButtonHeight, ElementName=root}"
        Style="{StaticResource MaterialDesignRaisedButton}">

        <StackPanel Orientation="Horizontal">

            <materialDesign:PackIcon
                Kind="{Binding Icon, ElementName=root}"
                Width="20"
                Height="20"
                Margin="0,0,8,0"/>

            <TextBlock
                VerticalAlignment="Center"
                Text="{Binding ButtonText, ElementName=root}"/>

        </StackPanel>

    </Button>

</UserControl>