<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SISBase"
        xmlns:Controls="clr-namespace:SISBase.Views.Controls" x:Class="SISBase.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Controls:UCButton
    ButtonText="Guardar"
    Icon="ContentSave"
    Command="{Binding SaveCommand}" Margin="385,202,289,189" />

        <Controls:UCButton
    ButtonText="Nuevo"
    Icon="Plus"
    Command="{Binding NewCommand}" Margin="0,0,671,392" Loaded="UCButton_Loaded" TouchEnter="UCButton_TouchEnter" />

        <Controls:UCButton
    ButtonText="Buscar"
    Icon="Magnify"
    Command="{Binding SearchCommand}" Margin="64,165,607,225" />

    </Grid>
</Window>
