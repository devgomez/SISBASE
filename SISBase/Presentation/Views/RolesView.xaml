<UserControl x:Class="SISBase.Presentation.Views.RolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">

    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================= -->
        <!-- FORMULARIO -->
        <!-- ========================================= -->

        <materialDesign:Card Grid.Column="0"
                             Padding="20">

            <StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,20">

                    <materialDesign:PackIcon
                        Kind="ShieldAccount"
                        Width="28"
                        Height="28"
                        Foreground="#1976D2"/>

                    <TextBlock Text="Gestión de Roles"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBox
                    IsReadOnly="True"
                    Text="{Binding SelectedRole.Id}"
                    materialDesign:HintAssist.Hint="ID"/>

                <TextBox
                    Margin="0,15,0,0"
                    Text="{Binding SelectedRole.Name, UpdateSourceTrigger=PropertyChanged}"
                    materialDesign:HintAssist.Hint="Nombre del Rol"/>

                <CheckBox Content="Activo"
                          Margin="0,15,0,0"
                          IsChecked="True"/>

                <Separator Margin="0,20"/>

                <Button Command="{Binding SaveCommand}"
                        Height="45"
                        Style="{StaticResource MaterialDesignRaisedButton}">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Kind="ContentSave"/>

                        <TextBlock Text="Guardar"
                                   Margin="10,0,0,0"/>

                    </StackPanel>

                </Button>

                <Button Command="{Binding NewCommand}"
                        Margin="0,10,0,0"
                        Height="45"
                        Style="{StaticResource MaterialDesignOutlinedButton}">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Kind="Plus"/>

                        <TextBlock Text="Nuevo"
                                   Margin="10,0,0,0"/>

                    </StackPanel>

                </Button>

                <Button Command="{Binding DeleteCommand}"
                        Margin="0,10,0,0"
                        Height="45"
                        Foreground="Red"
                        BorderBrush="Red">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Kind="Delete"/>

                        <TextBlock Text="Eliminar"
                                   Margin="10,0,0,0"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </materialDesign:Card>

        <!-- ========================================= -->
        <!-- DERECHA -->
        <!-- ========================================= -->

        <Grid Grid.Column="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- FILTROS -->

            <materialDesign:Card Grid.Row="0"
                                 Padding="20">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             materialDesign:HintAssist.Hint="Buscar rol..."
                             Text="{Binding SearchText}"/>

                    <ComboBox Grid.Column="2"
                              materialDesign:HintAssist.Hint="Estado">

                        <ComboBoxItem Content="Todos"/>
                        <ComboBoxItem Content="Activos"/>
                        <ComboBoxItem Content="Inactivos"/>

                    </ComboBox>

                    <ComboBox Grid.Column="4"
                              materialDesign:HintAssist.Hint="Ordenar">

                        <ComboBoxItem Content="Nombre A-Z"/>
                        <ComboBoxItem Content="Nombre Z-A"/>

                    </ComboBox>

                    <Button Grid.Column="6"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding SearchCommand}">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Kind="Magnify"/>

                            <TextBlock Text="Buscar"
                                       Margin="5,0,0,0"/>

                        </StackPanel>

                    </Button>

                </Grid>

            </materialDesign:Card>

            <!-- GRID -->

            <materialDesign:Card Grid.Row="2"
                                 Padding="15">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->

                    <DockPanel Margin="0,0,0,15">

                        <TextBlock Text="Lista de Roles"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left"/>

                        <Button DockPanel.Dock="Right"
                                Width="140"
                                Height="40"
                                Command="{Binding NewCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon
                                    Kind="Plus"/>

                                <TextBlock Text="Nuevo Rol"
                                           Margin="5,0,0,0"/>

                            </StackPanel>

                        </Button>

                    </DockPanel>

                    <!-- DATAGRID -->

                    <DataGrid
    ItemsSource="{Binding Roles}"
    SelectedItem="{Binding SelectedRole}"
    AutoGenerateColumns="False"
    CanUserAddRows="False"
    IsReadOnly="True"
    RowHeight="42"
    HeadersVisibility="Column">

                        <DataGrid.Columns>

                            <DataGridTextColumn
            Header="ID"
            Width="80"
            Binding="{Binding Id}"/>

                            <DataGridTextColumn
            Header="Nombre"
            Width="*"
            Binding="{Binding Name}"/>

                            <DataGridTemplateColumn
            Header="Acciones"
            Width="140">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <StackPanel Orientation="Horizontal">

                                            <Button
                            Command="{Binding DataContext.EditCommand,
                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}">

                                                <materialDesign:PackIcon Kind="Pencil"/>

                                            </Button>

                                            <Button
                            Command="{Binding DataContext.DeleteRowCommand,
                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}">

                                                <materialDesign:PackIcon Kind="Delete"/>

                                            </Button>

                                        </StackPanel>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                    <!-- PAGINACIÓN -->

                    <DockPanel Grid.Row="2"
                               Margin="0,15,0,0">

                        <TextBlock Text="Mostrando 1-10 de 150 registros"
                                   VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    DockPanel.Dock="Right">

                            <Button Content="First"
                                    Width="40"
                                    Margin="3"/>

                            <Button Content="Prev"
                                    Width="40"
                                    Margin="3"/>

                            <Button Content="1"
                                    Width="40"
                                    Margin="3"/>

                            <Button Content="2"
                                    Width="40"
                                    Margin="3"/>

                            <Button Content="3"
                                    Width="40"
                                    Margin="3"/>

                            <Button Content=">"
                                    Width="40"
                                    Margin="3"/>

                            <Button Content=">>"
                                    Width="40"
                                    Margin="3"/>

                        </StackPanel>

                    </DockPanel>

                </Grid>

            </materialDesign:Card>

        </Grid>

    </Grid>

</UserControl>